{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NAI ACLAB",
  "version": "2.1.0",
  "identifier": "com.nai-aclab.studio",
  "build": {
    "frontendDist": "../desktop-bootstrap"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/nai-engine"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "NovelAI artist combination studio",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzRTU1NURGNzQ2NTlEOTEKUldTUm5XVjAzMVhsazRFY1A4R3RJeVhURUNjREhCQ3VJMGNBNksyR05CSjhIOTFlQkxNTHVuNUsK",
      "endpoints": [
        "https://github.com/asyrian2021/NAI_ACLAB/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
